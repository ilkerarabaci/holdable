<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) launch theme (PO #1, light mode). The OS draws
         windowSplashScreenAnimatedIcon centred on windowSplashScreenBackground
         while the process starts, then runs a short exit animation into the
         Flutter UI — where the in-app SplashScreen takes over. The night-mode
         twin lives in values-night-v31/styles.xml; the version qualifier is
         needed there because night-mode outranks it during resource resolution. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenAnimationDuration">350</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
