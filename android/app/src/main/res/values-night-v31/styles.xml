<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) launch theme, dark mode (PO #1). Same splash
         attributes as values-v31/styles.xml; @color/splash_background resolves
         to the dark bg via values-night/colors.xml. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenAnimationDuration">350</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
